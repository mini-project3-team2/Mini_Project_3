# =========================================================
#  사용법: 이 파일을 복사해서 .env 를 만들고 값을 채우세요.
#    cp .env.example .env
#  .env 는 절대 커밋하지 않습니다. (.gitignore 에 등록됨)
#  CI·배포 값은 GitHub Secrets 에 등록합니다. 운영용 .env.prod 같은 파일을 저장소에 두지 않습니다. (가이드 3.3·6장)
# =========================================================

# ⚠️ 비밀번호·키 값에는 $ 와 따옴표를 쓰지 마세요.
#    - Docker Compose 는 $ 를 변수로 해석해 값이 잘립니다. (ab$cd → ab)
#    - Spring 은 따옴표를 값의 일부로 읽습니다. ('abc' → 'abc' 그대로)
#    → 같은 .env 를 둘 다 읽으므로, 영문+숫자 랜덤값을 권장합니다: openssl rand -hex 24

# ---------- Database (MariaDB) ----------
# MARIADB_USER 는 앱 전용 계정 이름 (root 사용 불가 - 컨테이너가 시작되지 않음)
MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=
MARIADB_USER=
MARIADB_PASSWORD=

# Backend 가 접속할 DB 정보 (Compose 내부에서는 host = database)
DB_HOST=localhost
DB_PORT=3306
# 로컬 PC 에 MariaDB/MySQL 이 이미 3306 을 쓰고 있다면 3307 등으로 변경 (호스트 쪽 포트만 바뀜)
DB_LOCAL_PORT=3306

# ---------- Backend (Spring Boot) ----------
# 최소 32바이트 이상 랜덤 문자열. 생성 예: openssl rand -base64 48
JWT_SECRET=
# 단위 ms. Access 15분 / Refresh 1일 (API 설계서 1장 · 화면은 sessionStorage 보관)
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Actuator 노출 최소화 (가이드 3.3). Micrometer 보안 지표(선택·가산)를 쓰면 health,info,metrics
ACTUATOR_EXPOSURE=health,info
# 관리자(ADMIN) 계정 - 기동 시 이 값으로 생성 (Flyway에 넣지 않음, DB 설계서 3장). Actuator 접근 확인용
ADMIN_EMAIL=
ADMIN_PASSWORD=
# (선택) 로그인 실패 잠금 시간(분), 기본 15. 시연 때 줄이려면 주석을 풀고 값 지정 (Compose 가이드 3장)
#  ※ 빈 값(LOGIN_LOCK_MINUTES=)으로 두지 말 것 - IDE 실행 시 Spring 이 빈 문자열을 숫자로 바꾸지 못해 기동 실패
# LOGIN_LOCK_MINUTES=1

# ---------- AI Module (FastAPI) ----------
# PC 에서 직접 실행: http://localhost:8000 / Compose 안에서 실행: http://ai-service:8000
AI_SERVICE_URL=http://localhost:8000
# Backend -> AI Module 내부 인증용 공유 토큰. 생성 예: openssl rand -hex 32
AI_INTERNAL_TOKEN=

# ---------- LLM · 임베딩 (가이드 3.4 - 코드 수정 없이 환경변수로만 전환) ----------
# Key 는 강사가 제공합니다. 팀 내부에서만 사용하고 코드·커밋·로그·캡처·발표 자료에 노출 금지.
#
#            개발·테스트 (로컬)              배포 (EC2 / K8s - GitHub Secrets 로 주입)
#   LLM      LLM_PROVIDER=groq               LLM_PROVIDER=openai
#            LLM_MODEL=<Groq 모델명>          LLM_MODEL=<OpenAI 모델명>
#   임베딩   개발·테스트·배포 공통 (팀 회의 결정 - 환경마다 바꾸지 않음)
#            EMBEDDING_PROVIDER=openai
#            EMBEDDING_MODEL=text-embedding-3-small (1536차원)
LLM_PROVIDER=groq
LLM_MODEL=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

GROQ_API_KEY=
# 임베딩이 OpenAI 이므로 개발 단계부터 필요 (AI 모듈 적재·검색)
OPENAI_API_KEY=

# 웹 검색 Tool - 사용 시 (개발·배포 공통, 가이드 3.5)
TAVILY_API_KEY=

# (선택) LangSmith 추적·평가 - 두 모델 결과 비교에 활용 (가이드 3.4-3)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# ---------- Frontend ----------
# Compose 전체 기동 시 frontend(Nginx) 가 게시할 로컬 포트. 80 을 다른 프로그램이 쓰고 있으면 8081 등으로 변경
FRONTEND_LOCAL_PORT=80
# Vite 는 이 루트 .env 를 읽지 않습니다. frontend/.env.example 을 참고하세요.

# ---------- 배포 서버(EC2) 전용 - docker-compose.prod.yml ----------
# 로컬 docker-compose.yml 은 쓰지 않으므로 로컬 .env 에서는 주석 그대로 둡니다.
# EC2 의 .env 에서만 주석을 풀고 값을 채웁니다. (이미지 이름: <DOCKERHUB_USERNAME>/asknote-{frontend,backend,ai})
# DOCKERHUB_USERNAME=
# 비우면 latest. 롤백할 때는 GitHub Actions 가 Push 한 이전 태그(예: sha-커밋해시)로 바꾸고 pull → up -d
# IMAGE_TAG=latest
