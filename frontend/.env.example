# 사용법: cp .env.example .env.local  (frontend 폴더 안에서)
# ⚠️ VITE_ 변수는 빌드 결과물(JS 번들)에 그대로 노출됩니다. API Key / 비밀번호 절대 금지!
# ⚠️ VITE_ 변수는 "빌드 시점"에 박제됩니다. Docker 이미지에서는 build arg 로 넘겨야 합니다.

# 권장: 상대경로 /api
#  - 개발: vite.config 의 server.proxy 로 /api → http://localhost:8080 전달
#  - 운영: nginx 가 /api → backend:8080 프록시
#  → 개발/운영 모두 같은 값이라 CORS·주소 불일치 문제가 줄어듭니다.
VITE_API_URL=/api

# MSW(Mock Service Worker) 사용 여부 — true 이면 개발 서버(npm run dev)에서만 mock-data/ 기반 가짜 응답을 사용
#  - 운영 빌드(npm run build)에서는 값과 상관없이 꺼집니다 (import.meta.env.DEV 확인)
#  - Backend 를 붙여 확인할 때는 false
VITE_USE_MOCK=false
